{
  "manifest_version": 3,
  "name": "AUTOCOMBAT",
  "version": "1.0",
  "description": "Human-Aligned Enhancement of Programming Answers with LLMs Guided by User Feedback",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.stackoverflow.com/questions/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
  {
    "matches": ["*://*.stackoverflow.com/*"],
    "js": [
      "scripts/contentScript.js",
      "scripts/highlight.min.js"
    ],
    "css": [
      "static/styles.css",
      "static/hljs-github.min.css"
    ],
    "run_at": "document_idle"
  }
],
"icons": {
    "48": "scripts/icon.jpg",
    "128": "scripts/icon.jpg"
},
  "action": {
    "default_title": "AUTOCOMBAT",
    "default_icon": {
      "48": "scripts/icon.jpg"
    }
  }
}
